+def _export_tail_context_fingerprint(seg, plan):
+    if (
+        not plan.continuity_enabled
+        or plan.continuity_mode != "guide"
+        or plan.continuity_keep_tail
+        or int(seg.index) < 1
+    ):
+        return {}
+    previous = plan.segments[int(seg.index) - 1]
+    if int(seg.index) == 1 and minimax_align_frame_count(previous.frame_count) == previous.frame_count:
+        return {}
+    return {"continuity_export_tail_pin": "decoded_v1"}
+
