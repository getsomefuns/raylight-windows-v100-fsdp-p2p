     """Same as official r2v: VAEDecode + VAEDecodeAudio both take the AV latent.
 
@@ -910,6 +919,20 @@ def execute_director_plan_core(
                 and (prev_av is not None or prev_audio is not None)
             )
             prev_av = select_continuity_pin_latent(latent, prev_first_pass_av, prev_av)
+            if (
+                not is_continue_mode(plan)
+                and not bool(getattr(plan, "continuity_keep_tail", True))
+                and _needs_export_tail_context(prev_end_frame, prev_tail)
+            ):
+                # The visible export can end between cached VAE phases. Encode
+                # its actual tail instead of discarding frames to align the latent.
+                prev_av = None
+                prev_low_carry = None
+                prev_end_frame = None
+                reports.append(
+                    f"Segment {ui_idx + 1}/{timeline_seg_total}: guide {context_n}f "
+                    "from decoded export tail; preserve previous duration, skip native low carry"
+                )
