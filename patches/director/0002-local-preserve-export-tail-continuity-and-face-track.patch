+def _needs_export_tail_context(context_end_frame, context_frames):
+    return (
+        context_end_frame is not None
+        and context_frames is not None
+        and int(context_frames.shape[0]) > 0
+        and minimax_align_frame_count(int(context_end_frame)) != int(context_end_frame)
+    )
+
+
